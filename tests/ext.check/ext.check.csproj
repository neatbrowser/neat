<Project Sdk="Microsoft.NET.Sdk">

  <!-- The self-check of the extension wrappers (src/neat/web/ext.cs). The wrappers talk to a
       profile only through a small interface, so they compile and run here without WebView2 or
       WinUI, against a fake profile; the real one (web/extprof.cs) is a few lines of glue and is
       not part of this check. CI runs it before the app is built (see .github/workflows/build.yml).
       Run it by hand from the repository root: dotnet run, with the option for this project
       folder (tests/ext.check). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ext.check</AssemblyName>
    <RootNamespace>extcheck</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\neat\web\ext.cs" LinkBase="web" />
  </ItemGroup>

</Project>
