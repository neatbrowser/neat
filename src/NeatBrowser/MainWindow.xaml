<Window
    x:Class="NeatBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar strip. It is also the drag area for the window; the
             system draws the minimize / maximize / close buttons on the
             right edge over it. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent">
            <TextBlock
                x:Name="StatusText"
                Text="NEAT Browser"
                Margin="14,0,140,0"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <WebView2 x:Name="Web" Grid.Row="1"/>
    </Grid>
</Window>
