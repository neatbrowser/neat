<Window
    x:Class="neat.Win"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:n="using:neat">

    <Grid
        x:Name="root"
        Background="{StaticResource bg}"
        RequestedTheme="Dark"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Title bar (always visible) =================
             Logo, sidebar toggle and navigation on the left, the address chip
             in the middle. The system draws minimize / maximize / close over
             the right end; the last column only keeps our content clear of
             them. The empty parts of this bar drag the window; the buttons
             are carved out as click-through regions in win.bar.cs. -->
        <Grid x:Name="bar" Grid.Row="0" Background="Transparent" Padding="8,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="146"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">

                <!-- Stand-in logo until NEAT has one. Its menu comes later. -->
                <Border
                    Width="22"
                    Height="22"
                    Margin="0,0,6,0"
                    CornerRadius="6"
                    Background="#33FFFFFF">
                    <TextBlock
                        Text="N"
                        FontSize="12"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>

                <!-- Sidebar toggle: a rounded panel with a bar down its left side. -->
                <Button
                    x:Name="tog"
                    Click="tog_Click"
                    Height="28"
                    Padding="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Toggle sidebar (Ctrl+S)">
                    <Grid Width="16" Height="13">
                        <Border
                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                            BorderThickness="1.5"
                            CornerRadius="3"/>
                        <Rectangle
                            Width="1.5"
                            HorizontalAlignment="Left"
                            Margin="5,0,0,0"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </Button>

                <Button x:Name="back" Click="back_Click" Height="28" Padding="8,0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <Button x:Name="fwd" Click="fwd_Click" Height="28" Padding="8,0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE72A;" FontSize="14"/>
                </Button>
                <Button x:Name="reload" Click="reload_Click" Height="28" Padding="8,0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </StackPanel>

            <!-- Address chip: copy link, the site's domain, bookmark star. -->
            <Border
                x:Name="pill"
                Grid.Column="1"
                MaxWidth="360"
                Height="26"
                Margin="12,0"
                Padding="2,0"
                CornerRadius="8"
                Background="#1AFFFFFF">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="copy"
                        Grid.Column="0"
                        Click="copy_Click"
                        Width="30"
                        Height="22"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Copy Link (Ctrl+Shift+C)">
                        <FontIcon x:Name="copyic" Glyph="&#xE71B;" FontSize="12"/>
                    </Button>

                    <!-- The domain is a button: it opens the command bar to edit this tab's address. -->
                    <Button
                        x:Name="domb"
                        Grid.Column="1"
                        Click="domb_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="22"
                        Padding="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Search or enter address (Ctrl+L)">
                        <TextBlock
                            x:Name="dom"
                            Text="New Tab"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"/>
                    </Button>

                    <Button
                        x:Name="star"
                        Grid.Column="2"
                        Click="star_Click"
                        Width="30"
                        Height="22"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Bookmark this page">
                        <FontIcon x:Name="staric" Glyph="&#xE734;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Body (below the title bar) ================= -->
        <Grid x:Name="body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="col0" Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Web frame with rounded corners. -->
            <Border
                x:Name="frame"
                Grid.Column="1"
                Margin="0,0,6,6"
                CornerRadius="{StaticResource r_web}"
                Background="#FF0F0F0F">
                <!-- Every tab's web view lives here; only the selected one is visible. -->
                <Grid x:Name="host"/>
            </Border>

            <!-- Left-edge hot zone. Only present while the sidebar is hidden:
                 the pointer touching it makes the sidebar float over the page. -->
            <Grid
                x:Name="hot"
                Grid.ColumnSpan="2"
                Width="8"
                HorizontalAlignment="Left"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="hot_In"
                PointerExited="hot_Out"/>

            <!-- Sidebar: one element, three states (see win.side.cs): docked
                 beside the page, hidden, or floating over the page while the
                 pointer is at the left edge. It lives in a layer spanning both
                 columns so it can overlap the page; column 0 only reserves its
                 space while docked. Docked, it has no panel of its own: the
                 window gradient runs straight from the title bar through it.
                 Only the floating sidebar gets a solid, bordered panel. -->
            <Border
                x:Name="side"
                Grid.ColumnSpan="2"
                Width="248"
                HorizontalAlignment="Left"
                Margin="{StaticResource pad}"
                Padding="10"
                CornerRadius="{StaticResource r_side}"
                BorderBrush="Transparent"
                BorderThickness="1"
                Background="Transparent"
                PointerEntered="side_In"
                PointerExited="side_Out">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Opens the command bar overlay; its result opens in a new tab. -->
                    <Button
                        x:Name="newtab"
                        Grid.Row="0"
                        Click="newtab_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New Tab"/>
                        </StackPanel>
                    </Button>

                <!-- One row per open tab. Selecting a row shows that tab. -->
                <ListView
                    x:Name="list"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="list_SelectionChanged">
                    <!-- Soft pill for the selected tab and a light wash on hover,
                         no accent bar. -->
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1AFFFFFF"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#26FFFFFF"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#40FFFFFF"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent"/>
                    </ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="n:Tab">
                            <Grid
                                Height="36"
                                ColumnSpacing="10"
                                Background="Transparent"
                                PointerEntered="row_In"
                                PointerExited="row_Out">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Visibility="{x:Bind IconVis, Mode=OneWay}"/>
                                <FontIcon
                                    Glyph="&#xE774;"
                                    FontSize="14"
                                    Visibility="{x:Bind GlyphVis, Mode=OneWay}"/>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Title, Mode=OneWay}"/>

                                <!-- Shown only while the pointer is over the row. -->
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Visibility="Collapsed"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="shut_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="info"
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            Opacity="0.6"
                            TextWrapping="Wrap"/>

                        <!-- Window colour: light or dark, brightness, gradient, and ready-made hues. -->
                        <Button
                            x:Name="paint"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Padding="8,6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Window colour">
                            <FontIcon Glyph="&#xE790;" FontSize="14"/>
                            <Button.Flyout>
                                <Flyout x:Name="fly" Placement="TopEdgeAlignedLeft">
                                    <StackPanel Width="270" Spacing="12">
                                        <ToggleSwitch
                                            x:Name="darksw"
                                            OnContent="Dark"
                                            OffContent="Light"
                                            Toggled="darksw_Toggled"/>
                                        <!-- Colour square: across is the hue, down is the brightness. Drag the dot. -->
                                        <Grid x:Name="square" Height="140" Background="Transparent"
                                              PointerPressed="square_Down"
                                              PointerMoved="square_Move"
                                              PointerReleased="square_Up"
                                              PointerCaptureLost="square_Lost">
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush x:Name="spec" StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="Red"/>
                                                        <GradientStop Offset="0.1667" Color="Yellow"/>
                                                        <GradientStop Offset="0.3333" Color="Lime"/>
                                                        <GradientStop Offset="0.5" Color="Cyan"/>
                                                        <GradientStop Offset="0.6667" Color="Blue"/>
                                                        <GradientStop Offset="0.8333" Color="Magenta"/>
                                                        <GradientStop Offset="1" Color="Red"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="10" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush x:Name="shade" StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#00000000"/>
                                                        <GradientStop Offset="1" Color="#99000000"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Canvas IsHitTestVisible="False">
                                                <Ellipse
                                                    x:Name="dot"
                                                    Width="18"
                                                    Height="18"
                                                    Stroke="White"
                                                    StrokeThickness="2"/>
                                            </Canvas>
                                        </Grid>
                                        <Slider
                                            x:Name="spread"
                                            Header="Gradient"
                                            Minimum="0"
                                            Maximum="1"
                                            StepFrequency="0.01"
                                            ValueChanged="spread_Changed"/>
                                        <StackPanel x:Name="sw" Orientation="Horizontal" Spacing="6"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Command bar overlay (hidden by default) ================= -->
        <Grid
            x:Name="scrim"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            Background="#99000000"
            Tapped="scrim_Tapped">
            <Border
                Width="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,140,0,0"
                Padding="10"
                CornerRadius="14"
                Background="#F2141414"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Tapped="panel_Tapped">
                <StackPanel Spacing="4">
                    <!-- Second typing test. -->
                    <TextBox
                        x:Name="q"
                        PlaceholderText="Search or Enter URL..."
                        KeyDown="q_KeyDown"/>
                    <TextBlock Text="Wikipedia  -  wikipedia.org" Padding="10,8"/>
                    <TextBlock Text="YouTube  -  youtube.com" Padding="10,8"/>
                    <TextBlock Text="Reddit  -  reddit.com" Padding="10,8"/>
                    <TextBlock Text="Add-ons for Firefox  -  addons.mozilla.org" Padding="10,8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
