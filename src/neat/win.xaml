<Window
    x:Class="neat.Win"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:n="using:neat">

    <Grid x:Name="root" Background="{StaticResource bg}" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar (full height, rounded panel) ================= -->
        <Border
            Grid.Column="0"
            Margin="{StaticResource pad}"
            Padding="10"
            CornerRadius="{StaticResource r_side}"
            Background="#26FFFFFF">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Back / forward / reload -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="back" Click="back_Click" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    </Button>
                    <Button x:Name="fwd" Click="fwd_Click" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE72A;" FontSize="14"/>
                    </Button>
                    <Button x:Name="reload" Click="reload_Click" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                    <Button x:Name="star" Click="star_Click" Background="Transparent" BorderThickness="0">
                        <FontIcon x:Name="staric" Glyph="&#xE734;" FontSize="14"/>
                    </Button>
                </StackPanel>

                <!-- Address box. Also the first typing test: try Vietnamese (Telex/VNI). -->
                <TextBox
                    x:Name="addr"
                    Grid.Row="1"
                    PlaceholderText="Search or Enter URL..."
                    KeyDown="addr_KeyDown"/>

                <!-- Opens the command bar overlay (the popup-over-web test). -->
                <Button
                    x:Name="newtab"
                    Grid.Row="2"
                    Click="newtab_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="New Tab"/>
                    </StackPanel>
                </Button>

                <!-- One row per open tab. Selecting a row shows that tab. -->
                <ListView
                    x:Name="list"
                    Grid.Row="3"
                    SelectionMode="Single"
                    SelectionChanged="list_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="n:Tab">
                            <Grid Height="36" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Visibility="{x:Bind IconVis, Mode=OneWay}"/>
                                <FontIcon
                                    Glyph="&#xE774;"
                                    FontSize="14"
                                    Visibility="{x:Bind GlyphVis, Mode=OneWay}"/>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Title, Mode=OneWay}"/>

                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="shut_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="info"
                    Grid.Row="4"
                    FontSize="11"
                    Opacity="0.6"
                    TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- ================= Content column ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thin strip: window drag area. The system draws min / max /
                 close at its right end. -->
            <Grid x:Name="drag" Grid.Row="0" Background="Transparent"/>

            <!-- Web frame: rounded corners test. -->
            <Border
                x:Name="frame"
                Grid.Row="1"
                Margin="0,0,6,6"
                CornerRadius="{StaticResource r_web}"
                Background="#FF0F0F0F">
                <!-- Every tab's web view lives here; only the selected one is visible. -->
                <Grid x:Name="host"/>
            </Border>
        </Grid>

        <!-- ================= Command bar overlay (hidden by default) ================= -->
        <Grid
            x:Name="scrim"
            Grid.ColumnSpan="2"
            Visibility="Collapsed"
            Background="#99000000"
            Tapped="scrim_Tapped">
            <Border
                Width="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,140,0,0"
                Padding="10"
                CornerRadius="14"
                Background="#F2141414"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Tapped="panel_Tapped">
                <StackPanel Spacing="4">
                    <!-- Second typing test. -->
                    <TextBox
                        x:Name="q"
                        PlaceholderText="Search or Enter URL..."
                        KeyDown="q_KeyDown"/>
                    <TextBlock Text="Wikipedia  -  wikipedia.org" Padding="10,8"/>
                    <TextBlock Text="YouTube  -  youtube.com" Padding="10,8"/>
                    <TextBlock Text="Reddit  -  reddit.com" Padding="10,8"/>
                    <TextBlock Text="Add-ons for Firefox  -  addons.mozilla.org" Padding="10,8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
